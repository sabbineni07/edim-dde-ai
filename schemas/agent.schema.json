{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edim.local/schemas/agent.schema.json",
  "title": "EDIM Agent Definition",
  "description": "Canonical YAML/JSON contract for edim-dde-ai agents (Release 1 / Phase 0).",
  "type": "object",
  "required": ["agent_id", "graph"],
  "additionalProperties": true,
  "properties": {
    "agent_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "entry": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "sync": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "content_dir": { "type": "string" },
    "prompts": { "type": "object" },
    "skills": { "type": "object" },
    "metadata": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "risk_tier": { "enum": ["low", "medium", "high"] },
        "lifecycle": { "enum": ["draft", "review", "approved", "deprecated"] },
        "hitl_required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "properties": {
        "ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": { "type": "object" }
    },
    "rag": { "type": ["object", "null"] },
    "security": {
      "type": "object",
      "properties": {
        "pii_redaction": { "type": "boolean" },
        "output_policy": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "dataset": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "hitl": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "graph": {
      "type": "object",
      "required": ["nodes"],
      "properties": {
        "entry": { "type": "string" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "edges": { "type": "array" },
        "conditional_edges": { "type": "array" },
        "routes": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
