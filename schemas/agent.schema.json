{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edim.local/schemas/agent.schema.json",
  "title": "EDIM Agent Definition",
  "description": "Canonical YAML/JSON contract for edim-dde-ai agents (Release 1 / Phase 0).",
  "type": "object",
  "required": ["agent_id", "graph"],
  "additionalProperties": true,
  "properties": {
    "agent_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "entry": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "sync": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "content_dir": { "type": "string" },
    "prompts": { "type": "object" },
    "skills": {
      "description": "Inline skills as map or list of {key,title,content}",
      "oneOf": [
        { "type": "object" },
        {
          "type": "array",
          "items": { "type": "object" }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "risk_tier": { "enum": ["low", "medium", "high"] },
        "lifecycle": { "enum": ["draft", "review", "approved", "deprecated"] },
        "hitl_required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "properties": {
        "ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "bindings": {
      "description": "Optional per-agent infra overrides; omit to use process .env globals. Use ${ENV:VAR} for URLs/names — never put API keys or secrets in YAML. LLM sampling knobs are literal numbers. Runtime wires llm, search (rag.retrieve), sql-warehouse (domain.sql.query), and cosmos (StateStore + RecommendationStore configure).",
      "type": "object",
      "properties": {
        "llm": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "description": "Foundry/OpenAI base URL or ${ENV:VAR_NAME}"
            },
            "deployment": {
              "type": "string",
              "minLength": 1,
              "description": "Deployment/model name or ${ENV:VAR_NAME}"
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Literal sampling temperature (not an env ref)"
            },
            "top_p": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Literal nucleus sampling top_p"
            },
            "top_k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "Literal top_k (provider-dependent; injected on config)"
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128000,
              "description": "Literal max completion tokens"
            }
          },
          "additionalProperties": true
        },
        "search": {
          "type": "object",
          "description": "Azure AI Search (parsed today; runtime injection later)",
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "description": "Search service URL or ${ENV:VAR_NAME}"
            },
            "index": {
              "type": "string",
              "minLength": 1,
              "description": "Physical index name or ${ENV:VAR_NAME}"
            }
          },
          "additionalProperties": true
        },
        "cosmos": {
          "type": "object",
          "description": "Cosmos DB (parsed today; runtime injection later)",
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "description": "Cosmos account URL or ${ENV:VAR_NAME}"
            },
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "Database name or ${ENV:VAR_NAME}"
            }
          },
          "additionalProperties": true
        },
        "sql-warehouse": {
          "type": "object",
          "description": "Databricks SQL warehouse (parsed today; runtime injection later)",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "description": "Workspace host or ${ENV:VAR_NAME}"
            },
            "http_path": {
              "type": "string",
              "minLength": 1,
              "description": "Warehouse HTTP path or ${ENV:VAR_NAME}"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": { "type": "object" }
    },
    "rag": {
      "type": ["object", "null"],
      "properties": {
        "enabled": { "type": "boolean" },
        "corpus": { "type": "string" },
        "top_k": { "type": "integer", "minimum": 1 },
        "search_mode": { "enum": ["vector", "keyword", "hybrid"] },
        "cite": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "properties": {
        "pii_redaction": { "type": "boolean" },
        "output_policy": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "dataset": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "hitl": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "graph": {
      "type": "object",
      "required": ["nodes"],
      "properties": {
        "entry": { "type": "string" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "edges": { "type": "array" },
        "conditional_edges": { "type": "array" },
        "routes": {
          "description": "Route sugar (list) or legacy map form",
          "oneOf": [
            { "type": "array" },
            { "type": "object" }
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
